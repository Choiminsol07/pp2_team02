import tkinter as tk

window = tk.Tk()
window.title("파이썬 함수 백과사전")
window.geometry("750x550")
window.configure(bg="#F2F5FA")

# 제목
title = tk.Label(
    window,
    text="파이썬 함수 백과사전",
    font=("맑은 고딕", 22, "bold"),
    bg="black",
    fg="whithe"
)
title.pack(pady=20)

# 검색창
search_frame = tk.Frame(window, bg="whithe")
search_frame.pack(pady=10)

search_entry = tk.Entry(
    search_frame,
    width=40,
    font=("맑은 고딕", 12)
)
search_entry.pack(side="left", padx=5)

search_button = tk.Button(
    search_frame,
    text="검색",
    width=10,
    bg="black",
    fg="white"
)
search_button.pack(side="left")

# 메인 화면
main_frame = tk.Frame(window, bg="black")
main_frame.pack(fill="both", expand=True, padx=20, pady=15)

# 함수 목록
left_frame = tk.Frame(main_frame, bg="white")
left_frame.pack(side="left", fill="both", expand=True, padx=5)

tk.Label(
    left_frame,
    text="함수 예시",
    font=("맑은 고딕", 14, "bold"),
    bg="white"
).pack(pady=15)

function_list = tk.Listbox(
    left_frame,
    font=("맑은 고딕", 12),
    height=15
)
function_list.pack(fill="both", expand=True, padx=15, pady=10)

# 함수 예시
examples = [
    "abs()", "all()", "any()", "bin()", "bool()", "bytearray()", "bytes()", "complex()", "dict()", "dir()", "eval()", "float()", "help()", "id()", "input()", "int()", "isinstance()", "len()", "list()", "max()", "min()", "object()", "open()", "print()", "range()", "reversed()", "set()", "sorted()", "str()", "sum()", "tuple()", "type()" ,"count()", "find()", "index()", "lower()", "lstrip()", "rstrip()", "split()", "strip()", "upper()"
]

for item in examples:
    function_list.insert(tk.END, item)

# 오른쪽 화면
right_frame = tk.Frame(main_frame, bg="white")
right_frame.pack(side="right", fill="both", expand=True, padx=5)

tk.Label(
    right_frame,
    text="함수 설명",
    font=("맑은 고딕", 14, "bold"),
    bg="white"
).pack(pady=15)

detail_text = tk.Label(
    right_frame,
    text="함수를 선택하면\n이곳에 설명이 표시됩니다.",
    font=("맑은 고딕", 12),
    bg="white",
    justify="center"
)
detail_text.pack(fill="both", expand=True)

# 즐겨찾기 버튼
favorite_button = tk.Button(
    right_frame,
    text="★ 즐겨찾기",
    font=("맑은 고딕", 11),
    width=15,
    bg="blue"
)
favorite_button.pack(pady=20)

# 하단 버튼
bottom_frame = tk.Frame(window, bg="white")
bottom_frame.pack(pady=15)

tk.Button(
    bottom_frame,
    text="전체 함수",
    width=15
).pack(side="left", padx=10)

tk.Button(
    bottom_frame,
    text="즐겨찾기 목록",
    width=15
).pack(side="left", padx=10)

window.mainloop()